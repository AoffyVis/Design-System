{
  "$theme": "banking",
  "$description": "Brand theme for the Banking business unit. Green-teal palette per docs/06-theme.md's worked Banking theme example. Only color tokens are overridden — typography, spacing, radius, breakpoint, zIndex, and motion are shared.",
  "color": {
    "primary": {
      "main": { "value": "#004D40", "type": "color" },
      "contrast": { "value": "#E0F2F1", "type": "color" }
    },
    "secondary": {
      "main": { "value": "#00695C", "type": "color" },
      "contrast": { "value": "#FFFFFF", "type": "color" }
    },
    "error": {
      "main": { "value": "#B71C1C", "type": "color" },
      "contrast": { "value": "#FFFFFF", "type": "color" }
    },
    "warning": {
      "main": { "value": "#E65100", "type": "color" },
      "contrast": { "value": "#FFFFFF", "type": "color" }
    },
    "success": {
      "main": { "value": "#1B5E20", "type": "color" },
      "contrast": { "value": "#FFFFFF", "type": "color" }
    },
    "info": {
      "main": { "value": "#01579B", "type": "color" },
      "contrast": { "value": "#FFFFFF", "type": "color" }
    },
    "surface": {
      "main": { "value": "#F1F8F6", "type": "color" },
      "contrast": { "value": "#1B2E2A", "type": "color" }
    },
    "border": {
      "main": { "value": "rgba(0, 77, 64, 0.12)", "type": "color" }
    }
  }
}
